{
    "tasks": [
        {
            "id": "r.generate",
            "name": "R - Generate simulation tasks",
            "command": "python3 r_simulation/generate_tasks.py --count 5 --output .scripthut/all_examples/r-tasks.json --partition standard --prefix r.",
            "environment": "python",
            "partition": "standard",
            "cpus": 1,
            "memory": "1G",
            "time_limit": "00:05:00",
            "generates_source": ".scripthut/all_examples/r-tasks.json"
        },
        {
            "id": "python.generate",
            "name": "Python - Generate pricing tasks",
            "command": "python3 python_simulation/generate_tasks.py --count 5 --output .scripthut/all_examples/python-tasks.json --partition standard --prefix py.",
            "environment": "python",
            "partition": "standard",
            "cpus": 1,
            "memory": "1G",
            "time_limit": "00:05:00",
            "generates_source": ".scripthut/all_examples/python-tasks.json"
        },
        {
            "id": "julia.generate",
            "name": "Julia - Generate bootstrap tasks",
            "command": "python3 julia_simulation/generate_tasks.py --count 5 --output .scripthut/all_examples/julia-tasks.json --partition standard --prefix jl.",
