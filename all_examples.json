            "partition": "standard",
            "cpus": 1,
            "memory": "1G",
            "time_limit": "00:05:00",
            "generates_source": ".scripthut/all_examples/julia-tasks.json"
        },
        {
            "id": "apptainer.generate",
            "name": "Apptainer - Build container and generate tasks",
            "command": "python3 apptainer_python/generate_tasks.py --count 5 --output .scripthut/all_examples/apptainer-tasks.json --partition standard --prefix apt.",
            "environment": "python",
            "partition": "standard",
            "cpus": 1,
            "memory": "2G",
            "time_limit": "00:10:00",
            "generates_source": ".scripthut/all_examples/apptainer-tasks.json"
        },
        {
            "id": "bash.setup",
            "name": "Bash - Setup",
            "command": "bash simple_task.sh 1",
            "working_dir": "bash_simulation"
        },
        {
            "id": "bash.build.x",
            "name": "Bash - Build-X",
            "command": "bash simple_task.sh 2",
            "working_dir": "bash_simulation",
            "cpus": 2,
            "memory": "2G",
            "deps": ["bash.setup"]
        },
        {
            "id": "bash.build.y",
            "name": "Bash - Build-Y",
